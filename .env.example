# Copia este archivo a .env para trabajar en local (no lo subas al repo).
# En Railway estas mismas claves se ponen en la pestaña "Variables".

# Contraseña del modo edición (/?edit=1). Sin ella, la edición queda apagada.
EDIT_PASSWORD=pon-aqui-una-contrasena-larga

# Firma las cookies de la sesión de edición. Cualquier texto largo y aleatorio.
# Si no la pones, se usa EDIT_PASSWORD (y al cambiarla se cierran las sesiones).
SESSION_SECRET=

# Postgres. En Railway se rellena sola con ${{ Postgres.DATABASE_URL }}.
# Si la dejas vacía, el contenido se guarda en un JSON dentro de DATA_DIR.
DATABASE_URL=

# Carpeta persistente donde se guardan las fotos y vídeos que subas.
# En Railway es el punto de montaje del volumen: /data
DATA_DIR=

# Dirección pública de la web. Solo sirve para las etiquetas de compartir.
SITE_URL=

# Tamaño máximo de cada archivo subido, en MB.
MAX_UPLOAD_MB=120
